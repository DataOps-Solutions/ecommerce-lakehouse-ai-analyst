# Copy to .env and adjust. Never commit real credentials.

# --- Storage ---------------------------------------------------------------
# local: data/lakehouse/<layer>/<table> on disk (default, no external services)
# s3:    s3://$S3_BUCKET/$S3_PREFIX/<layer>/<table> (AWS S3 or MinIO)
LAKEHOUSE_STORAGE=local
LAKEHOUSE_LOCAL_DIR=data/lakehouse
S3_BUCKET=lakehouse
S3_PREFIX=ecommerce
# Leave empty for AWS S3. For the local MinIO from docker-compose use:
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM -------------------------------------------------------------------
# mock: deterministic, no credentials required (default)
# bedrock: AWS Bedrock Runtime Converse API (uses the AWS credentials above)
LLM_PROVIDER=mock
BEDROCK_REGION=us-east-1
# Any Bedrock model id enabled in your account, for example:
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# --- Personal data (ingest-csv) -----------------------------------------------
# Secret used to pseudonymize customer identifiers (HMAC-like SHA-256 with salt).
# Required when a mapping pseudonymizes fields. Keep it secret and never commit it.
# Changing it unlinks the tokens from previous loads.
PSEUDONYMIZATION_SALT=

# --- Pipeline and analyst --------------------------------------------------
DATA_SEED=20260101
SQL_ROW_LIMIT=1000
OUTPUT_DIR=output
SEMANTIC_LAYER_PATH=semantic_layer/metrics.yaml
